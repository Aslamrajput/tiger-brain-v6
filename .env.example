# Tiger Brain V19 — Environment Variables
# =========================================
# Is file ko copy karke .env banao aur real values bharo:
#   cp .env.example .env
#
# .env file KABHI bhi GitHub pe commit nahi hoti (.gitignore mein hai).

# Angel One SmartAPI credentials (broker login ke liye)
ANGEL_CLIENT_ID=your_client_id
ANGEL_MPIN=your_mpin
ANGEL_TOTP_SECRET=your_totp_secret
ANGEL_API_KEY=your_api_key
